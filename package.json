  "types": "build/index.d.mts",
  "files": [
    "src",
    "build"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --project ./tsconfig.json",
    "rollup": "rollup -c",
    "build-all": "npm run build && npm run rollup",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webnt-dev/tembra.git"
  },
  "keywords": [],
  "author": {
    "name": "Bronislav Klučka",
    "email": "Bronislav.Klucka@webnt.dev"
  },
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/webnt-dev/tembra/issues"
  },
  "homepage": "https://github.com/webnt-dev/tembra#readme",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.0.0",
    "npm-check-updates": "^22.2.3",
    "rollup": "^4.62.2",
    "rollup-plugin-summary": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.mts",
