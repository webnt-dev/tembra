    },
    "./cms/article": {
      "types": "./build/cms/article/index.d.mts",
      "import": "./build/cms/article/index.mjs"
    },
    "./cms/text": {
      "types": "./build/cms/text/index.d.mts",
      "import": "./build/cms/text/index.mjs"
    },
    "./cms/page": {
      "types": "./build/cms/page/index.d.mts",
      "import": "./build/cms/page/index.mjs"
    },
    "./cms/keyvalue": {
      "types": "./build/cms/keyvalue/index.d.mts",
      "import": "./build/cms/keyvalue/index.mjs"
    },
    "./system": {
      "types": "./build/system/index.d.mts",
      "import": "./build/system/index.mjs"
